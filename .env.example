# Copy to .env. Three settings matter; everything below them has a working
# default and exists only so you can change it if you need to.

# --- The three ----------------------------------------------------------

# Where the product is served from, as a browser sees it. One origin covers
# everything: the web app, the API under /api/v1 and identity under /api/auth.
# No trailing slash.
APP_URL=http://localhost:5173

# Signs session cookies and the JWTs the API verifies. Generate with:
#   openssl rand -hex 32
# Changing it signs everyone out.
AUTH_SECRET=

# The database password. Identity keeps its own schema inside the same
# database, created for you on first boot.
POSTGRES_PASSWORD=postgres

# --- Optional -----------------------------------------------------------

# Sign-in with Google is offered only when both are present, so email and
# password alone needs nothing here. Create the client at
# https://console.cloud.google.com/apis/credentials with redirect URI
#   <APP_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# How often health is re-derived from telemetry. A status change has to be
# noticed while nobody is watching, so it runs on a timer rather than on read.
# Only one instance evaluates at a time; the rest skip the pass.
HEALTH_EVAL_INTERVAL_SECONDS=60

# Telemetry older than this has its whole monthly partition dropped. At roughly
# 580 bytes an event, a million events a month is around 580 MB a month.
TELEMETRY_RETENTION_DAYS=90

# integration_api=debug is useful while developing and far too loud in
# production, where it logs every request.
RUST_LOG=integration_api=info,warn

# --- Running the API outside compose ------------------------------------
# `cargo run` in apps/api reads this file too. These point at the compose
# Postgres on its published port, and at the auth service on its.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/integration_observability
AUTH_JWKS_URL=http://localhost:3010/api/auth/jwks
HOST=0.0.0.0
PORT=8080

# --- Escape hatch -------------------------------------------------------
# Set this to keep identity in a separate database instead of a schema. You
# have to create that database yourself; `CREATE DATABASE` needs a privilege
# that some managed Postgres providers do not grant.
# AUTH_DATABASE_URL=

# Extra origins allowed to complete a sign-in, comma separated. APP_URL is
# always trusted; this is for a second domain or a native client.
# AUTH_TRUSTED_ORIGINS=

# Host port the web container publishes on.
# WEB_PORT=5173
