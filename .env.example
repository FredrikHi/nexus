# Copy to .env for local `cargo run`. Loaded by dotenvy at startup.
# Points at the compose Postgres published on host port 5433.
DATABASE_URL=postgres://postgres:postgres@localhost:5433/integration_observability
HOST=0.0.0.0
PORT=8080
RUST_LOG=integration_api=debug,tower_http=debug,info

# Health evaluation worker. It derives per-integration health from telemetry on
# a timer, because a status change has to be noticed when nobody is watching.
# Only one instance evaluates at a time; the rest skip the pass.
HEALTH_EVAL_INTERVAL_SECONDS=60
# Telemetry older than this has its whole monthly partition dropped.
TELEMETRY_RETENTION_DAYS=90
# Set to false on an instance that should serve traffic without evaluating.
HEALTH_WORKER_ENABLED=true

# --- Authentication -----------------------------------------------------
# Identity is a separate Better Auth service. The API never reads its tables;
# it verifies the tokens it signs, using the public keys it publishes.
#
# Required. Generate with: openssl rand -hex 32
AUTH_SECRET=
# Where the auth service is reachable from a browser. Must match the issuer
# the API expects and the redirect URIs registered with any OAuth provider.
AUTH_BASE_URL=http://localhost:3010
# Origins allowed to complete a sign-in. The Vite dev server by default.
AUTH_TRUSTED_ORIGINS=http://localhost:5173
#
# Sign-in with Google is offered only when both of these are present, so a
# self-hoster who only wants email and password can leave them blank.
# Create the client at https://console.cloud.google.com/apis/credentials with
# redirect URI  <AUTH_BASE_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
